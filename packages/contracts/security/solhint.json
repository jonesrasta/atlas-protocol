{
  "extends": "solhint:recommended",

  "rules": {
    "compiler-version": [
      "error",
      "^0.8.30"
    ],

    "func-visibility": "off",
    "import-path-check": "off",
    "no-global-import": "off",

    "gas-indexed-events": "warn",
    "ordering": "warn",
    "use-natspec": "warn",
    "immutable-vars-naming": "warn",
    "no-empty-blocks": "warn"
  }
}
